{
  "routes": [
    {
      "route": "/*",
      "allowedRoles": ["anonymous", "authenticated"],
      "serve": "/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "globalHeaders": {
    "X-Frame-Options": "DENY"
  },
  "forwardingGateway": {
    "www.khrate.com": "https://www.khrate.com"
  }
}
